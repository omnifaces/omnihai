<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.omnifaces</groupId>
    <artifactId>omnihai</artifactId>
    <version>1.7.2</version>
    <packaging>jar</packaging>

    <name>OmniHai</name>
    <description>AI utility library</description>
    <url>https://omnihai.org</url>
    <organization>
        <name>OmniFaces</name>
        <url>https://omnifaces.org</url>
    </organization>
    <inceptionYear>2026</inceptionYear>

    <developers>
        <developer>
            <id>balusc</id>
            <name>Bauke Scholtz</name>
            <email>balusc@gmail.com</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/omnifaces/omnihai</url>
        <connection>scm:git:git://github.com/omnifaces/omnihai.git</connection>
        <developerConnection>scm:git:git@github.com:omnifaces/omnihai.git</developerConnection>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>

        <!-- Java versions. -->
        <javase.version>17</javase.version>
        <jakartaee.version>11</jakartaee.version>

        <!-- Essential Maven defaults. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>${javase.version}</maven.compiler.release>
        <maven.source.excludeResources>true</maven.source.excludeResources>
        <skipUTs>false</skipUTs>
        <skipITs>true</skipITs>

        <!-- Sonar config. -->
        <sonar.organization>balusc-github</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- Ignored rules live in the project settings on SonarCloud, not here, as sonar.issue.ignore.multicriteria is a multi value property which is not
             persisted when it is passed by the scanner. -->
    </properties>

    <dependencies>

        <!-- Required Jakarta EE 11 dependencies. -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Optional Jakarta EE 11 dependencies. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.1.0</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-el-api</artifactId>
            <version>4.1.0</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>3.1</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.21.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>6.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.context-propagation</groupId>
            <artifactId>microprofile-context-propagation-api</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.weld</groupId>
            <artifactId>weld-junit5</artifactId>
            <version>5.0.3.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
            <version>3.18.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>

            <!-- Populate application.properties. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <!-- Prevent wrong JDK from being used to build the project. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${javase.version},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Add missing license headers to source files. -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <executions>
                    <execution>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>format</goal>
                        </goals>
                        <configuration>
                            <licenseSets>
                                <licenseSet>
                                    <header>LICENSE.txt</header>
                                    <excludes>
                                       <exclude>*.*</exclude> <!-- excludes files in root folder -->
                                       <exclude>**/*.txt</exclude>
                                       <exclude>src/test/resources/**</exclude>
                                    </excludes>
                                </licenseSet>
                            </licenseSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Apply code formatting (Java via Eclipse JDT). -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <java>
                        <eclipse>
                            <file>${project.basedir}/src/main/eclipse-formatter.xml</file>
                        </eclipse>
                        <importOrder>
                            <file>${project.basedir}/src/main/eclipse-importorder.txt</file>
                        </importOrder>
                        <removeUnusedImports />
                        <trimTrailingWhitespace />
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>pom.xml</include>
                                <include>src/**/*.xml</include>
                            </includes>
                            <trimTrailingWhitespace />
                            <endWithNewline />
                            <indent>
                                <spaces>true</spaces>
                                <spacesPerTab>4</spacesPerTab>
                            </indent>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Compile the test sources with -parameters, so that tool methods can rely on reflective parameter names. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <parameters>true</parameters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Configure the unit tests (*Test.java) and the plain Java SE unit tests (*VanillaTest.java). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <skipTests>${skipUTs}</skipTests>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/*VanillaTest.java</exclude>
                                <exclude>**/*CDIContainerTest.java</exclude>
                                <exclude>**/*NoTempFilesTest.java</exclude>
                                <exclude>**/*ManagedExecutorTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>

                    <!-- The optional APIs are off the runtime classpath here, which is what makes the guards around them testable as guards. -->
                    <execution>
                        <id>vanilla-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*VanillaTest.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/*CDIOnlyVanillaTest.java</exclude>
                                <exclude>**/*CDINoELVanillaTest.java</exclude>
                                <exclude>**/*NoJsonVanillaTest.java</exclude>
                            </excludes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>jakarta.enterprise:jakarta.enterprise.cdi-api</classpathDependencyExclude>
                                <classpathDependencyExclude>jakarta.enterprise:jakarta.enterprise.cdi-el-api</classpathDependencyExclude>
                                <classpathDependencyExclude>jakarta.el:jakarta.el-api</classpathDependencyExclude>
                                <classpathDependencyExclude>org.glassfish.expressly:expressly</classpathDependencyExclude>
                                <classpathDependencyExclude>org.eclipse.microprofile.config:microprofile-config-api</classpathDependencyExclude>
                                <classpathDependencyExclude>io.smallrye.config:smallrye-config</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>

                    <!-- CDI is on the runtime classpath here, but the EL and MicroProfile Config implementations are not, which is the runtime a bare CDI
                         container offers. -->
                    <execution>
                        <id>cdi-only-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*CDIOnlyVanillaTest.java</include>
                            </includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.glassfish.expressly:expressly</classpathDependencyExclude>
                                <classpathDependencyExclude>org.eclipse.microprofile.config:microprofile-config-api</classpathDependencyExclude>
                                <classpathDependencyExclude>io.smallrye.config:smallrye-config</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>

                    <!-- CDI is on the runtime classpath here, but the EL binding it offers an expression is not, which is the runtime a CDI container
                         without EL support offers. -->
                    <execution>
                        <id>cdi-no-el-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*CDINoELVanillaTest.java</include>
                            </includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>jakarta.enterprise:jakarta.enterprise.cdi-el-api</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>

                    <!-- A CDI container is booted here, which is what makes the annotations testable as annotations rather than as producer method arguments.
                         It runs in a fork of its own because ExecutorServiceHelper picks its executor once per JVM, on whether a container was up by then. -->
                    <execution>
                        <id>cdi-container-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*CDIContainerTest.java</include>
                            </includes>
                            <properties>
                                <configurationParameters>
                                    <!-- A container is looked up through the thread context class loader, which a parallel worker thread does not carry. -->
                                    junit.jupiter.execution.parallel.enabled = false
                                </configurationParameters>
                            </properties>
                        </configuration>
                    </execution>

                    <!-- A Jakarta EE server offers its own managed executor through the naming service, which is stubbed here, as the library picks its
                         executor once per JVM and therefore cannot be shown both answers in one. -->
                    <execution>
                        <id>managed-executor-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*ManagedExecutorTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <java.naming.factory.initial>org.omnifaces.ai.service.StubInitialContextFactory</java.naming.factory.initial>
                            </systemPropertyVariables>
                            <properties>
                                <configurationParameters>
                                    <!-- A container is looked up through the thread context class loader, which a parallel worker thread does not carry. -->
                                    junit.jupiter.execution.parallel.enabled = false
                                </configurationParameters>
                            </properties>
                        </configuration>
                    </execution>

                    <!-- The temporary directory is not there here, which is the runtime a read-only file system offers, and which the in-memory fallbacks
                         around FileHelper.tempFilesSupported() exist for. -->
                    <execution>
                        <id>no-temp-files-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*NoTempFilesTest.java</include>
                            </includes>
                            <!-- Set on the command line rather than as a system property, as the JDK reads it before a property set from within can take. -->
                            <argLine>@{argLine} -Djava.io.tmpdir=${project.build.directory}/no-temp-files</argLine>
                        </configuration>
                    </execution>

                    <!-- JSON-P is off the runtime classpath here, which is the one dependency the produced services cannot do without. -->
                    <execution>
                        <id>no-json-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*NoJsonVanillaTest.java</include>
                            </includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>jakarta.json:jakarta.json-api</classpathDependencyExclude>
                                <classpathDependencyExclude>org.eclipse.parsson:parsson</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Configure the code coverage report which the Sonar analysis reads. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <skip>${skipUTs}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- The Sonar analysis runs up to package, so the report has to be there before verify. -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Configure the integration tests (*IT.java). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Configure the jar with the binaries. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <URL>${project.url}</URL>
                            <Extension-Name>${project.artifactId}</Extension-Name>
                            <Automatic-Module-Name>${project.groupId}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Configure the jar with the sources. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Configure the jar with the javadoc. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <javadocExecutable>${java.home}/bin/javadoc</javadocExecutable>
                    <notimestamp>true</notimestamp>
                    <splitindex>true</splitindex>
                    <doclint>all</doclint>
                    <doctitle>OmniHai API documentation</doctitle>
                    <links>
                        <link>https://jakarta.ee/specifications/platform/${jakartaee.version}/apidocs/</link>
                    </links>
                    <tags>
                        <tag>
                            <name>implNote</name>
                            <placement>a</placement>
                            <head>Implementation Note:</head>
                        </tag>
                    </tags>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Configure snapshot deployment (release deployment is done via 'release' profile). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <!-- Left out on 17 because of a Javadoc bug it carries: it warns that a record component carries no comment where the record documents its components
             itself, which 18 fixed. The rule therefore holds from the first Java without that bug. -->
        <profile>
            <id>javadoc-warnings-are-errors</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <failOnWarnings>true</failOnWarnings>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Release deploy: mvn clean deploy -P release -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <deploymentName>${project.artifactId}-${project.version}</deploymentName>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>

                    <!-- Signing with GPG is a requirement for a release deployment to Maven central. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
